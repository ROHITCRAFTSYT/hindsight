# Normalize line endings: store text as LF, check out as LF everywhere.
* text=auto eol=lf

# Explicit text types
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets — never touch
*.png binary
*.jpg binary
*.ico binary
